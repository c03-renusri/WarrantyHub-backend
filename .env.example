# Copy to .env only for local use. Spring does not automatically load .env.
# Generate your own value with: openssl rand -base64 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
PORT=8080
DB_URL=jdbc:mysql://localhost:3306/warrantyhub
DB_USER=warrantyhub
DB_PASSWORD=
# Railway alternative: set MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER,
# MYSQLPASSWORD from the MySQL service reference variables. Do not set dev profile.
